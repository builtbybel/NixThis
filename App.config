<?xml version="1.0" encoding="utf-8"?>
<configuration>

  <!-- The manifest promises Windows that this app scales itself, so Windows stops stretching
       the picture. On .NET Framework that promise is empty until WinForms is told to keep it,
       and that happens here: without these two keys every window stays laid out for 96 dpi. -->
  <System.Windows.Forms.ApplicationConfigurationSection>
    <add key="DpiAwareness" value="PerMonitorV2" />
    <add key="EnableWindowsFormsHighDpiAutoResizing" value="true" />
  </System.Windows.Forms.ApplicationConfigurationSection>

</configuration>
